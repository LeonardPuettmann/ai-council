# Provider keys (only set the ones you'll use)
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Default models — format: provider:model
# providers: anthropic | mistral
ALFRED_MODEL=anthropic:claude-sonnet-4-6
COUNCIL_DEFAULT_MODEL=anthropic:claude-sonnet-4-6

# Per-member overrides (key = uppercase folder name with - replaced by _)
# Examples:
# COUNCIL_MODEL_HARVEY_SPECTER=mistral:mistral-large-latest
# COUNCIL_MODEL_PEWDIEPIE=mistral:mistral-small-latest

# Debate limits
MAX_DEBATE_ROUNDS=3
MAX_TOKENS_PER_TURN=600

# Sampling temperature per provider.
# Lower = more focused/deterministic. Higher = more varied/creative.
# Anthropic native default is 1.0; Mistral native default is 0.7.
ANTHROPIC_TEMPERATURE=1.0
MISTRAL_TEMPERATURE=0.3
